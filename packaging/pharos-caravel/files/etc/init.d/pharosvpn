#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
# Copyright (C) 2026 The PharosVPN Authors
#
# procd service for the PharosVPN OpenWrt client. `caravel-owrt connect` runs in
# the foreground and tears its own routes down on SIGTERM, which is exactly the
# lifecycle procd wants: it supervises the worker and signals it on stop/reload.

USE_PROCD=1
START=95
STOP=10

PROG=/usr/sbin/caravel-owrt

start_service() {
	config_load pharosvpn

	local enabled profile connection node full_tunnel
	config_get_bool enabled main enabled 0
	config_get profile main profile ""
	config_get connection main connection ""
	config_get node main node ""
	config_get_bool full_tunnel main full_tunnel 1

	[ "$enabled" = "1" ] || return 0
	if [ -z "$profile" ]; then
		echo "pharosvpn: no profile configured (uci set pharosvpn.main.profile=NAME)" >&2
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" connect --profile "$profile"
	[ -n "$connection" ] && procd_append_param command --connection "$connection"
	[ -n "$node" ] && procd_append_param command --node "$node"
	if [ "$full_tunnel" = "1" ]; then
		procd_append_param command --full-tunnel
	else
		procd_append_param command --full-tunnel=false
	fi
	# Respawn the worker if it exits. threshold=30s: an instance that can't stay
	# up 30s is treated as a fast failure; wait 5s between respawns; after 5 such
	# fast failures give up (so a bad/wrong-password profile can't spin forever).
	# A tunnel that has been up longer than 30s and then drops respawns fresh.
	procd_set_param respawn 30 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	# Reload (stop+start) when /etc/config/pharosvpn changes.
	procd_add_reload_trigger "pharosvpn"
}
